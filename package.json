{
  "name": "person-count",
  "version": "1.0.0",
  "private": true,
  "description": "Detecção de pessoas em vídeos com React e TensorFlow.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,front \"npm:dev:server\" \"npm:dev:front\"",
    "dev:server": "node --watch src/server.js",
    "dev:front": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "start": "node src/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "chart.js": "^4.4.8",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "sass": "^1.89.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
